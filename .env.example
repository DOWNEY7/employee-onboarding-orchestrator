# ── Azure OpenAI (preferred) ──────────────────────────────────────────────────
LLM_PROVIDER=azure                        # "azure" or "openai"
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-api-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4o           # deployment name, e.g. gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# ── OpenAI fallback (used when LLM_PROVIDER=openai) ──────────────────────────
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# ── App settings ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./onboarding.db   # LangGraph checkpoint store
PACK_OUTPUT_DIR=./output_packs           # where finalised ZIPs are written
