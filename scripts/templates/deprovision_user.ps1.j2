#Requires -Version 7.0
#Requires -Modules Microsoft.Graph.Users, Microsoft.Graph.Groups, Microsoft.Graph.Identity.SignIns

<#
.SYNOPSIS
    Security-ordered de-provisioning of a leaver account via Microsoft Graph.
    AUTO-GENERATED by Employee Onboarding Orchestrator — DO NOT EDIT MANUALLY.

.DESCRIPTION
    Generated for  : {{ display_name }} ({{ email }})
    Last Working Day: {{ last_working_day }}
    Reason          : {{ reason }}
    Generated At    : {{ generated_at }}

    ⚠️  CRITICAL: Execute steps in the order listed. Do NOT skip or reorder.
    Steps are arranged from highest to lowest security priority.

.NOTES
    This script is an ARTIFACT ONLY — review and test in a non-production
    environment before executing against your tenant.
    Ensure you have User.ReadWrite.All, Group.ReadWrite.All, and
    Directory.AccessAsUser.All permissions in your app registration.
#>

[CmdletBinding(SupportsShouldProcess, ConfirmImpact = 'High')]
param(
    [Parameter(Mandatory = $false)]
    [string]$TenantId = $env:AZURE_TENANT_ID,

    [Parameter(Mandatory = $false)]
    [string]$ClientId = $env:AZURE_CLIENT_ID,

    [Parameter(Mandatory = $false)]
    [string]$ClientSecret = $env:AZURE_CLIENT_SECRET,

    [Parameter(Mandatory = $false)]
    [string]$DataTransferRecipient = '{{ data_transfer_recipient }}'
)

Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'
$VerbosePreference = 'Continue'

# ── Authentication ─────────────────────────────────────────────────────────────
Write-Host "🔐 Connecting to Microsoft Graph..." -ForegroundColor Cyan
$SecureSecret = ConvertTo-SecureString $ClientSecret -AsPlainText -Force
$Credential   = New-Object System.Management.Automation.PSCredential($ClientId, $SecureSecret)
Connect-MgGraph -TenantId $TenantId -ClientSecretCredential $Credential -NoWelcome

# ── Resolve User ───────────────────────────────────────────────────────────────
Write-Host "🔍 Resolving leaver: {{ email }}" -ForegroundColor Cyan
$User = Get-MgUser -UserId '{{ email }}' -ErrorAction SilentlyContinue
if (-not $User) {
    Write-Error "❌ User not found: {{ email }}. De-provisioning aborted."
    Disconnect-MgGraph | Out-Null
    exit 1
}
Write-Host "   Object ID   : $($User.Id)"
Write-Host "   Display Name: $($User.DisplayName)"

# ── STEP 1 (CRITICAL): Revoke All Sessions and Refresh Tokens ────────────────
Write-Host "`n[STEP 1 — CRITICAL] Revoking all sessions and refresh tokens..." -ForegroundColor Red
if ($PSCmdlet.ShouldProcess('{{ email }}', 'Revoke all sign-in sessions')) {
    Revoke-MgUserSignInSession -UserId $User.Id
    # Also set signInSessionsValidFromDateTime to force token expiry
    Update-MgUser -UserId $User.Id -SignInSessionsValidFromDateTime (Get-Date).ToUniversalTime()
    Write-Host "   ✅ All sessions and refresh tokens revoked." -ForegroundColor Green
}

# ── STEP 2 (CRITICAL): Disable Account ────────────────────────────────────────
Write-Host "`n[STEP 2 — CRITICAL] Disabling Azure AD account..." -ForegroundColor Red
if ($PSCmdlet.ShouldProcess('{{ email }}', 'Disable account (accountEnabled = false)')) {
    Update-MgUser -UserId $User.Id -AccountEnabled:$false
    Write-Host "   ✅ Account disabled. Sign-in blocked." -ForegroundColor Green
}

# ── STEP 3 (CRITICAL): Remove from All Security Groups ───────────────────────
Write-Host "`n[STEP 3 — CRITICAL] Removing from all group memberships..." -ForegroundColor Red
$MemberOf = Get-MgUserMemberOf -UserId $User.Id -All
$GroupsRemoved = 0
foreach ($DirectoryObject in $MemberOf) {
    if ($DirectoryObject.OdataType -eq '#microsoft.graph.group') {
        if ($PSCmdlet.ShouldProcess($DirectoryObject.Id, "Remove {{ display_name }} from group")) {
            try {
                Remove-MgGroupMemberByRef -GroupId $DirectoryObject.Id -DirectoryObjectId $User.Id
                $GroupsRemoved++
                Write-Verbose "   Removed from group: $($DirectoryObject.Id)"
            } catch {
                Write-Warning "   ⚠️  Could not remove from group $($DirectoryObject.Id): $_"
            }
        }
    }
}
Write-Host "   ✅ Removed from $GroupsRemoved group(s)." -ForegroundColor Green

# ── STEP 4: Remove All Licences ───────────────────────────────────────────────
Write-Host "`n[STEP 4 — HIGH] Removing all M365 licences..." -ForegroundColor Yellow
$AssignedLicences = (Get-MgUser -UserId $User.Id -Property AssignedLicenses).AssignedLicenses
if ($AssignedLicences.Count -gt 0) {
    if ($PSCmdlet.ShouldProcess('{{ email }}', 'Remove all licences')) {
        $LicenceParams = @{
            UserId         = $User.Id
            AddLicenses    = @()
            RemoveLicenses = $AssignedLicences | Select-Object -ExpandProperty SkuId
        }
        Set-MgUserLicense @LicenceParams
        Write-Host "   ✅ Removed $($AssignedLicences.Count) licence(s)." -ForegroundColor Green
    }
} else {
    Write-Host "   ℹ️  No licences assigned — nothing to remove." -ForegroundColor DarkGray
}

# ── STEP 7: Remove MFA Methods ────────────────────────────────────────────────
Write-Host "`n[STEP 7 — HIGH] Removing MFA authentication methods..." -ForegroundColor Yellow
try {
    $AuthMethods = Get-MgUserAuthenticationMethod -UserId $User.Id
    foreach ($Method in $AuthMethods) {
        Write-Verbose "   Found method: $($Method.OdataType) — $($Method.Id)"
        # Individual method deletion requires specific cmdlets per method type.
        # Run Remove-MgUserAuthenticationMethod* for each type found.
    }
    Write-Host "   ℹ️  MFA methods identified: $($AuthMethods.Count). Remove interactively via Entra portal or specific Remove-Mg* cmdlets." -ForegroundColor DarkYellow
} catch {
    Write-Warning "   ⚠️  Could not enumerate MFA methods: $_"
}

# ── STEP 10: Wipe Intune Devices ──────────────────────────────────────────────
Write-Host "`n[STEP 10 — HIGH] Queuing Intune device wipe..." -ForegroundColor Yellow
Write-Host "   ℹ️  Use Intune portal or Invoke-MgDeviceManagementManagedDeviceWipe for enrolled devices." -ForegroundColor DarkYellow
Write-Host "   ℹ️  Search: Get-MgDeviceManagementManagedDevice -Filter `"userPrincipalName eq '{{ email }}'`"" -ForegroundColor DarkGray

# ── FINAL: Summary ─────────────────────────────────────────────────────────────
Write-Host ""
Write-Host "═══════════════════════════════════════════════════════════════" -ForegroundColor DarkGray
Write-Host "  DE-PROVISIONING SUMMARY — {{ display_name }}" -ForegroundColor White
Write-Host "═══════════════════════════════════════════════════════════════" -ForegroundColor DarkGray
Write-Host "  ✅ Sessions revoked    (Step 1 — CRITICAL)" -ForegroundColor Green
Write-Host "  ✅ Account disabled    (Step 2 — CRITICAL)" -ForegroundColor Green
Write-Host "  ✅ Groups removed      (Step 3 — CRITICAL) — $GroupsRemoved groups" -ForegroundColor Green
Write-Host "  ✅ Licences removed    (Step 4 — HIGH)" -ForegroundColor Green
Write-Host "  ⚠️  Steps 5-17: Complete manually or via supplemental scripts." -ForegroundColor Yellow
Write-Host "═══════════════════════════════════════════════════════════════" -ForegroundColor DarkGray
Write-Host ""
Write-Host "⚠️  Do not close this session until you have completed steps 5-17." -ForegroundColor Yellow

Disconnect-MgGraph | Out-Null
Write-Host "🔒 Disconnected from Microsoft Graph." -ForegroundColor Cyan
