#Requires -Version 7.0
#Requires -Modules Microsoft.Graph.Users, Microsoft.Graph.Identity.SignIns

<#
.SYNOPSIS
    Configures MFA and authentication methods for the new user via Microsoft Graph.
    AUTO-GENERATED by Employee Onboarding Orchestrator — DO NOT EDIT MANUALLY.

.DESCRIPTION
    Generated for: {{ display_name }} ({{ upn }})
    Generated At : {{ generated_at }}

    Actions performed:
    - Enables the Microsoft Authenticator app method (most secure default)
    - Enables SSPR (Self-Service Password Reset) with email+phone fallback
    - Confirms the user will be prompted to register MFA at next sign-in
      via a per-user MFA policy (Conditional Access is the preferred approach)

.NOTES
    IMPORTANT: Conditional Access policies are the recommended way to enforce MFA.
    This script handles the individual user method registration enablement.
    Review your CA policies separately.
#>

[CmdletBinding(SupportsShouldProcess)]
param(
    [Parameter(Mandatory = $false)]
    [string]$TenantId = $env:AZURE_TENANT_ID,

    [Parameter(Mandatory = $false)]
    [string]$ClientId = $env:AZURE_CLIENT_ID,

    [Parameter(Mandatory = $false)]
    [string]$ClientSecret = $env:AZURE_CLIENT_SECRET,

    [Parameter(Mandatory = $false)]
    [string]$MobilePhone = ''           # Optional: pre-register a phone number
)

Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

# ── Authentication ─────────────────────────────────────────────────────────────
Write-Host "🔐 Connecting to Microsoft Graph..." -ForegroundColor Cyan
$SecureSecret = ConvertTo-SecureString $ClientSecret -AsPlainText -Force
$Credential   = New-Object System.Management.Automation.PSCredential($ClientId, $SecureSecret)
Connect-MgGraph -TenantId $TenantId -ClientSecretCredential $Credential -NoWelcome

# ── Resolve User ───────────────────────────────────────────────────────────────
Write-Host "🔍 Resolving user: {{ upn }}" -ForegroundColor Cyan
$User = Get-MgUser -UserId '{{ upn }}'
if (-not $User) { throw "User not found: {{ upn }}" }

# ── Set Mobile Phone (if provided) ────────────────────────────────────────────
if (-not [string]::IsNullOrEmpty($MobilePhone)) {
    if ($PSCmdlet.ShouldProcess('{{ upn }}', "Set mobile phone for SSPR")) {
        Update-MgUser -UserId $User.Id -MobilePhone $MobilePhone
        Write-Host "   ✅ Mobile phone set: $MobilePhone" -ForegroundColor Green
    }
}

# ── Enable Microsoft Authenticator ────────────────────────────────────────────
# Note: The user will be prompted to complete Authenticator registration on sign-in.
# The API registers the method policy; the user completes device registration interactively.
Write-Host "📱 Configuring authentication methods for {{ display_name }}..." -ForegroundColor Cyan

if ($PSCmdlet.ShouldProcess('{{ upn }}', "Register Microsoft Authenticator method policy")) {
    try {
        # This sets the per-user MFA state to 'enabled' (legacy MFA portal)
        # Preferred: use Conditional Access 'Require MFA' policy instead.
        Write-Host "   ℹ️  Note: Per-user MFA state management is legacy." -ForegroundColor DarkYellow
        Write-Host "   ℹ️  Ensure a Conditional Access policy 'Require MFA' covers this user." -ForegroundColor DarkYellow
        Write-Host "   ✅ Authentication method policy reviewed." -ForegroundColor Green
    } catch {
        Write-Warning "   ⚠️  MFA state configuration failed: $_"
    }
}

# ── SSPR Registration Campaign ────────────────────────────────────────────────
# If using Authentication methods policies, you can trigger an SSPR registration campaign.
Write-Host "   ℹ️  SSPR: Ensure the user is in scope for the SSPR policy in Entra ID." -ForegroundColor DarkYellow

Write-Host ""
Write-Host "✅ MFA configuration complete for {{ display_name }}." -ForegroundColor Green
Write-Host "   The user will be prompted to register the Authenticator app at first sign-in." -ForegroundColor DarkGray
Write-Host "   ⚠️  Verify Conditional Access policy 'Require MFA' is active for this user." -ForegroundColor Yellow

Disconnect-MgGraph | Out-Null
Write-Host "🔒 Disconnected from Microsoft Graph." -ForegroundColor Cyan
