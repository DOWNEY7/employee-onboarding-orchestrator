#Requires -Version 7.0
#Requires -Modules Microsoft.Graph.Users, Microsoft.Graph.Identity.DirectoryManagement

<#
.SYNOPSIS
    Assigns an M365 licence to the new user account.
    AUTO-GENERATED by Employee Onboarding Orchestrator — DO NOT EDIT MANUALLY.

.DESCRIPTION
    Generated for: {{ display_name }} ({{ upn }})
    Licence SKU  : {{ licence_sku }}
    Department   : {{ department }}
    Generated At : {{ generated_at }}

.NOTES
    This script is an ARTIFACT ONLY — review before executing against your tenant.
    Retrieve the correct SKU GUID from your tenant before running:
      Get-MgSubscribedSku | Select-Object SkuPartNumber, SkuId
#>

[CmdletBinding(SupportsShouldProcess)]
param(
    [Parameter(Mandatory = $false)]
    [string]$TenantId = $env:AZURE_TENANT_ID,

    [Parameter(Mandatory = $false)]
    [string]$ClientId = $env:AZURE_CLIENT_ID,

    [Parameter(Mandatory = $false)]
    [string]$ClientSecret = $env:AZURE_CLIENT_SECRET,

    # Override the SKU ID if the default does not match your tenant
    [Parameter(Mandatory = $false)]
    [string]$LicenceSkuId = ''
)

Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

# ── SKU Map (common SKUs — verify against your tenant) ────────────────────────
$SkuMap = @{
    'E3' = 'reseller-account:ENTERPRISEPACK'
    'E5' = 'reseller-account:ENTERPRISEPREMIUM'
    'F3' = 'reseller-account:FRONTLINE'
}

# ── Authentication ─────────────────────────────────────────────────────────────
Write-Host "🔐 Connecting to Microsoft Graph..." -ForegroundColor Cyan
$SecureSecret = ConvertTo-SecureString $ClientSecret -AsPlainText -Force
$Credential   = New-Object System.Management.Automation.PSCredential($ClientId, $SecureSecret)
Connect-MgGraph -TenantId $TenantId -ClientSecretCredential $Credential -NoWelcome

# ── Resolve User ───────────────────────────────────────────────────────────────
Write-Host "🔍 Resolving user: {{ upn }}" -ForegroundColor Cyan
$User = Get-MgUser -UserId '{{ upn }}'
if (-not $User) { throw "User not found: {{ upn }}" }

# ── Resolve SKU ────────────────────────────────────────────────────────────────
$TargetSku = '{{ licence_sku }}'
if ([string]::IsNullOrEmpty($LicenceSkuId)) {
    $AllSkus = Get-MgSubscribedSku
    # Try exact SkuPartNumber match first
    $Sku = $AllSkus | Where-Object { $_.SkuPartNumber -eq $TargetSku } | Select-Object -First 1
    if (-not $Sku) {
        # Fall back to the map
        $FriendlyId = $SkuMap[$TargetSku]
        $Sku = $AllSkus | Where-Object { $_.SkuId -eq $FriendlyId -or $_.SkuPartNumber -eq $FriendlyId } | Select-Object -First 1
    }
    if (-not $Sku) {
        Write-Warning "⚠️  SKU '$TargetSku' not found in tenant. Available SKUs:"
        $AllSkus | Select-Object SkuPartNumber, SkuId, ConsumedUnits | Format-Table
        throw "Cannot continue — SKU not resolved."
    }
    $LicenceSkuId = $Sku.SkuId
    Write-Host "   Resolved SKU: $($Sku.SkuPartNumber) → $LicenceSkuId" -ForegroundColor Green
}

# ── Assign Licence ─────────────────────────────────────────────────────────────
if ($PSCmdlet.ShouldProcess('{{ upn }}', "Assign $TargetSku licence")) {
    $LicenceParams = @{
        UserId         = $User.Id
        AddLicenses    = @(@{ SkuId = $LicenceSkuId; DisabledPlans = @() })
        RemoveLicenses = @()
    }
    Set-MgUserLicense @LicenceParams
    Write-Host "✅ Licence '$TargetSku' assigned to {{ display_name }}." -ForegroundColor Green
}

Disconnect-MgGraph | Out-Null
Write-Host "🔒 Disconnected from Microsoft Graph." -ForegroundColor Cyan
