#Requires -Version 7.0
#Requires -Modules Microsoft.Graph.Groups

<#
.SYNOPSIS
    Adds the new user to all required security and M365 groups.
    AUTO-GENERATED by Employee Onboarding Orchestrator — DO NOT EDIT MANUALLY.

.DESCRIPTION
    Generated for: {{ display_name }} ({{ upn }})
    Department   : {{ department }}
    Groups       : {{ groups | length }} groups configured
    Generated At : {{ generated_at }}

.NOTES
    This script is an ARTIFACT ONLY — review before executing.
    Verify group IDs against your tenant:
      Get-MgGroup -Filter "displayName eq 'GROUP_NAME'" | Select-Object Id, DisplayName
#>

[CmdletBinding(SupportsShouldProcess)]
param(
    [Parameter(Mandatory = $false)]
    [string]$TenantId = $env:AZURE_TENANT_ID,

    [Parameter(Mandatory = $false)]
    [string]$ClientId = $env:AZURE_CLIENT_ID,

    [Parameter(Mandatory = $false)]
    [string]$ClientSecret = $env:AZURE_CLIENT_SECRET
)

Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

# ── Authentication ─────────────────────────────────────────────────────────────
Write-Host "🔐 Connecting to Microsoft Graph..." -ForegroundColor Cyan
$SecureSecret = ConvertTo-SecureString $ClientSecret -AsPlainText -Force
$Credential   = New-Object System.Management.Automation.PSCredential($ClientId, $SecureSecret)
Connect-MgGraph -TenantId $TenantId -ClientSecretCredential $Credential -NoWelcome

# ── Resolve User ───────────────────────────────────────────────────────────────
Write-Host "🔍 Resolving user: {{ upn }}" -ForegroundColor Cyan
$User = Get-MgUser -UserId '{{ upn }}'
if (-not $User) { throw "User not found: {{ upn }}" }
Write-Host "   Object ID: $($User.Id)" -ForegroundColor DarkGray

# ── Group Membership List ──────────────────────────────────────────────────────
# ⚠️  Replace placeholder GUIDs with actual group IDs from your tenant.
$Groups = @(
{% for group in groups %}
    @{ Name = '{{ group.name }}'; Id = '{{ group.id }}' }{% if not loop.last %},{% endif %}

{% endfor %}
)

if ($Groups.Count -eq 0) {
    Write-Warning "No groups configured for department '{{ department }}'. Skipping."
    Disconnect-MgGraph | Out-Null
    exit 0
}

# ── Add User to Groups ─────────────────────────────────────────────────────────
$Results = @{ Success = 0; Skipped = 0; Failed = 0 }

foreach ($Group in $Groups) {
    if ($PSCmdlet.ShouldProcess($Group.Name, "Add {{ display_name }}")) {
        try {
            # Check if already a member
            $Existing = Get-MgGroupMember -GroupId $Group.Id -Filter "id eq '$($User.Id)'" -ErrorAction SilentlyContinue
            if ($Existing) {
                Write-Host "   ⏭  Already a member of '$($Group.Name)' — skipping." -ForegroundColor DarkYellow
                $Results.Skipped++
                continue
            }

            New-MgGroupMember -GroupId $Group.Id -DirectoryObjectId $User.Id
            Write-Host "   ✅ Added to: $($Group.Name)" -ForegroundColor Green
            $Results.Success++
        } catch {
            Write-Warning "   ❌ Failed to add to '$($Group.Name)': $_"
            $Results.Failed++
        }
    }
}

Write-Host ""
Write-Host "📊 Summary — Added: $($Results.Success) | Skipped: $($Results.Skipped) | Failed: $($Results.Failed)" -ForegroundColor Cyan

Disconnect-MgGraph | Out-Null
Write-Host "🔒 Disconnected from Microsoft Graph." -ForegroundColor Cyan
